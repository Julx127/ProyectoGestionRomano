<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Proyecto Gestión</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <section>
        <a href="/">VOLVER</a> <!--Uso / para volver-->
        <a href="/clientes">MENU</a> <!--En los href pongo las rutas que invente en rutaCliente-->
        <a href="clientesVer">VER</a>
        <a href="#"  class="seleccion">AGREGAR</a>
        <a href="clientesModificar">MODIFICAR</a>
        <a href="clientesEliminar">ELIMINAR</a>
        <a href="clientesConsultar">CONSULTAR</a>
    </section>
    <h1>AGREGAR</h1>
    <form action="/clientes/nuevo" method="POST">
        <input name="id" type="text" placeholder="ID" maxlength="8" size="15">
        <input name="nomcli" type="text" placeholder="Nombre" maxlength="20" size="15">
        <input name="dircli" type="text" placeholder="Dirección" maxlength="20" size="15">
        <input name="telcli" type="text" placeholder="Teléfono" maxlength="8" size="15">
        <input name="ciudad" type="text" placeholder="Ciudad" maxlength="20" size="15">
        <button name="enviar" type="submit">Registrar</button>
    </form>
</body>